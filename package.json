{
  "name": "@corbits/credential-header",
  "version": "0.1.0",
  "description": "Header-shaped credential provider for Interchange: x-api-key, raw Authorization, any header.",
  "license": "LGPL-2.1-only",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "peerDependencies": {
    "@intx/harness": ">=0.4.0",
    "@intx/types": ">=0.4.0"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@intx/harness": "0.4.0",
    "@intx/types": "0.4.0",
    "@types/bun": "1.3.9",
    "eslint": "9.34.0",
    "jiti": "2.5.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.42.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-credential-header.git"
  },
  "homepage": "https://github.com/corbitsdev/corbits-credential-header",
  "bugs": {
    "url": "https://github.com/corbitsdev/corbits-credential-header/issues"
  }
}
